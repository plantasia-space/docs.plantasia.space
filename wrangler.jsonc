// Cloudflare Workers static site (PLA-747). Assets only, no Worker code.
// Two Workers from this repo, both built by Workers Builds (linked to GitHub):
//   ps-docs       ← main → docs.plantasia.space         build: npm run build:cf
//   ps-docs-dev   ← dev  → xplorer-docs.plantasia.space build: DOCS_SITE=dev npm run build:cf
//                                                       deploy: npx wrangler deploy --env dev
// Response headers come from build/_headers, written by scripts/cf-headers.mjs.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ps-docs",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./build",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "env": {
    "dev": {}
  }
}
