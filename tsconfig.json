{
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noEmit": true,
    "types": [
      "node",
      "@docusaurus/module-type-aliases"
    ],
    "target": "ES2022",
    "lib": [
      "DOM",
      "ES2022"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "allowJs": true
  },
  "include": [
    "src/assistant/**/*.ts",
    "src/assistant/**/*.tsx",
    "src/theme/Root.tsx",
    "tests/assistant/**/*.ts"
  ]
}
